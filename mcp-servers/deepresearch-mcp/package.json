{
  "name": "deepresearch-mcp-server",
  "version": "1.1.1",
  "description": "MCP server for deep research functionality in Cursor IDE",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "test:integration": "node integration-test.js",
    "test:all": "npm run test && npm run test:integration",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "cursor",
    "deep-research",
    "ai",
    "research-tool"
  ],
  "author": "AI Assistant",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@google/generative-ai": "^0.21.0",
    "node-fetch": "^3.3.2",
    "cheerio": "^1.0.0-rc.12",
    "turndown": "^7.1.2",
    "fs-extra": "^11.2.0",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/turndown": "^5.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
