{
  "name": "@google/gemini-cli-vscode-ide-companion",
  "version": "0.3.0",
  "description": "VSCode IDE companion extension for Gemini CLI with Cursor integration",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "npm run compile",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "watch": "node esbuild.js --watch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "gemini",
    "ai",
    "cursor",
    "subagents",
    "parallel-execution",
    "code-review",
    "debugging",
    "optimization",
    "security"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cursor.subagent.codeReview",
        "title": "サブエージェント: コードレビュー",
        "category": "Cursor Subagents"
      },
      {
        "command": "cursor.subagent.debug",
        "title": "サブエージェント: デバッグ",
        "category": "Cursor Subagents"
      },
      {
        "command": "cursor.subagent.optimize",
        "title": "サブエージェント: 最適化",
        "category": "Cursor Subagents"
      },
      {
        "command": "cursor.subagent.security",
        "title": "サブエージェント: セキュリティ監査",
        "category": "Cursor Subagents"
      },
      {
        "command": "cursor.subagent.parallel",
        "title": "サブエージェント: 並列実行",
        "category": "Cursor Subagents"
      },
      {
        "command": "cursor.subagent.status",
        "title": "サブエージェント: 状態確認",
        "category": "Cursor Subagents"
      }
    ],
    "keybindings": [
      {
        "command": "cursor.subagent.codeReview",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus"
      },
      {
        "command": "cursor.subagent.debug",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus"
      },
      {
        "command": "cursor.subagent.optimize",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "editorTextFocus"
      },
      {
        "command": "cursor.subagent.security",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorTextFocus"
      },
      {
        "command": "cursor.subagent.parallel",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "editorTextFocus"
      },
      {
        "command": "cursor.subagent.status",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cursor.subagent.codeReview",
          "group": "cursor-subagents",
          "when": "editorTextFocus"
        },
        {
          "command": "cursor.subagent.debug",
          "group": "cursor-subagents",
          "when": "editorTextFocus"
        },
        {
          "command": "cursor.subagent.optimize",
          "group": "cursor-subagents",
          "when": "editorTextFocus"
        },
        {
          "command": "cursor.subagent.security",
          "group": "cursor-subagents",
          "when": "editorTextFocus"
        },
        {
          "command": "cursor.subagent.parallel",
          "group": "cursor-subagents",
          "when": "editorTextFocus"
        }
      ],
      "commandPalette": [
        {
          "command": "cursor.subagent.codeReview"
        },
        {
          "command": "cursor.subagent.debug"
        },
        {
          "command": "cursor.subagent.optimize"
        },
        {
          "command": "cursor.subagent.security"
        },
        {
          "command": "cursor.subagent.parallel"
        },
        {
          "command": "cursor.subagent.status"
        }
      ]
    },
    "configuration": {
      "title": "Cursor Subagents",
      "properties": {
        "cursorSubagents.enableRealTimeSync": {
          "type": "boolean",
          "default": true,
          "description": "リアルタイム同期を有効にする"
        },
        "cursorSubagents.enableAutoCodeReview": {
          "type": "boolean",
          "default": true,
          "description": "自動コードレビューを有効にする"
        },
        "cursorSubagents.enableParallelExecution": {
          "type": "boolean",
          "default": true,
          "description": "並列実行を有効にする"
        },
        "cursorSubagents.maxConcurrentTasks": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "最大並列タスク数"
        },
        "cursorSubagents.syncInterval": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "同期間隔（ミリ秒）"
        },
        "cursorSubagents.autoSaveInterval": {
          "type": "number",
          "default": 300000,
          "minimum": 60000,
          "maximum": 1800000,
          "description": "自動保存間隔（ミリ秒）"
        }
      }
    }
  },
  "dependencies": {
    "@google/gemini-cli-core": "file:../core"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "vsce": "^2.0.0"
  },
  "publisher": "google",
  "repository": {
    "type": "git",
    "url": "https://github.com/google/gemini-cli.git"
  },
  "license": "Apache-2.0",
  "icon": "assets/icon.png"
}
