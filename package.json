{
  "name": "@google/gemini-cli",
  "version": "0.28.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "mcp-servers/*"
  ],
  "private": "true",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/google-gemini/gemini-cli.git"
  },
  "config": {
    "sandboxImageUri": "us-docker.pkg.dev/gemini-code-dev/gemini-cli/sandbox:0.28.1"
  },
  "scripts": {
    "start": "cross-env node scripts/start.js",
    "start:a2a-server": "CODER_AGENT_PORT=41242 npm run start --workspace @google/gemini-cli-a2a-server",
    "debug": "cross-env DEBUG=1 node --inspect-brk scripts/start.js",
    "build": "node scripts/build.js",
    "build:all": "npm run build && npm run build --workspace @google/gemini-cli-sandbox && npm run build --workspace @google/gemini-cli-vscode-ide-companion",
    "test": "vitest",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "lint": "node scripts/lint.js",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "node scripts/clean.js",
    "preflight": "npm-run-all clean build lint typecheck test",
    "pre-commit": "node scripts/pre-commit.js",
    "bundle": "node scripts/copy_bundle_assets.js"
  },
  "dependencies": {
    "ink": "npm:@jrichman/ink@6.4.8",
    "latest-version": "^9.0.0",
    "simple-git": "^3.28.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^0.12.0",
    "@octokit/rest": "^22.0.0",
    "@types/marked": "^5.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/minimatch": "^5.1.2",
    "@types/mock-fs": "^4.13.4",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/shell-quote": "^1.7.5",
    "@vitest/coverage-v8": "^3.1.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "comment-json": "^4.3.0",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "esbuild": "^0.25.0",
    "esbuild-plugin-wasm": "^1.1.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-headers": "^1.3.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "glob": "^12.0.0",
    "globals": "^16.0.0",
    "google-artifactregistry-auth": "^3.4.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "json": "^11.0.0",
    "lint-staged": "^16.1.6",
    "memfs": "^4.42.0",
    "mnemonist": "^0.40.3",
    "mock-fs": "^5.5.0",
    "msw": "^2.10.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "react-devtools-core": "^6.1.2",
    "semver": "^7.7.2",
    "strip-ansi": "^7.1.2",
    "ts-prune": "^0.10.3",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1",
    "yargs": "^17.7.2"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.1.0",
    "@lydell/node-pty-darwin-arm64": "1.1.0",
    "@lydell/node-pty-darwin-x64": "1.1.0",
    "@lydell/node-pty-linux-x64": "1.1.0",
    "@lydell/node-pty-win32-arm64": "1.1.0",
    "@lydell/node-pty-win32-x64": "1.1.0",
    "keytar": "^7.9.0",
    "node-pty": "^1.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "eslint.config.js": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
